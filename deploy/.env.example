# Домен сервера (HTTPS выпустится автоматически) или :80 для работы только по HTTP
DOMAIN=example.com
POSTGRES_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
CORS_ORIGINS=https://example.com
# Токены proverkacheka.com через запятую (сканирование чеков)
PROVERKACHEKA_TOKENS=

# Куда публиковать порты на хосте; если 443 занят, можно, например, HTTPS_PUBLISH=127.0.0.1:8443
# HTTP_PUBLISH=80
# HTTPS_PUBLISH=443
